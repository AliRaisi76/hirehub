generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CANDIDATE
  EMPLOYER
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(CANDIDATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
